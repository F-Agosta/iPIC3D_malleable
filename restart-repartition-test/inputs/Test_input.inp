# INPUT FILE for Minimal 1D Thermal Plasma
# 2 Species

#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%
SaveDirName    = runs/save/baseline-2        # Output directory
RestartDirName = runs/restart/baseline-2        # Restart directory (for WriteMethod=default)

#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%

Case              = default                           # Case [ GEM | Dipole | ... ]
FieldsInit        = maxwell # Initial fields h5 file
PartInit          = maxwell                          # Initial particles [ maxwell | mono | File ]
PartInj           = maxwell                             # Particle injector [ maxwell | mono ]
WriteMethod       = shdf5                           # Output method [ default | Parallel ]
PoissonCorrection = no                              # Poisson correction [ yes | no ]
SimulationName    = data                      # Simulation name for the output

#  %%%%%%%%%%%%%%%%%%% Magnetic Reconnection %%%%%%%%%%%%%%%%%%
B0x = 0.00
B0y = 0.00
B0z = 0.00

# External magnetic field parameters:
B1x = 0.000
B1y = 0.000
B1z = 0.000

delta = 0.5

#  %%%%%%%%%%%%%%%%%%% TIME %%%%%%%%%%%%%%%%%%
dt = 0.05             # dt = time step  
ncycles = 2000          # cycles
th = 1.0               # th =   decentering parameter
c = 1.0                # c = light speed 

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%
Smooth = 0.5           # Smoothing value (5-points stencil)
NVolte = 6 

# %%%%%%%%%%%%%%%%%% BOX SIZE %%%%%%%%%%%%%%%
Lx =  10.0 # 10.24            # Lx = simulation box length - x direction   
Ly =  1.0 # 10.24          # Ly = simulation box length - y direction
Lz =   1.0             # Lz = simulation box length - z direction   

x_center =   1.        # Lx = simulation box length - x direction in m  
y_center =   1.        # Ly = simulation box length - y direction in m
z_center =   1.        # Lz = simulation box length - z direction in m  
L_square =   .1

CoilD = 25.2	       #magnetic coil diameter -- Proposed WB8 simulation dimensions. 
CoilSpacing= 40.0      #spacing parameter for magnets 

nxc =  64 #256              # nxc = number of cells - x direction - must be a multiple of XLEN        
nyc =  1 #256             # nyc = number of cells - y direction - must be a multiple of YLEN
nzc =  1               # nzc = number of cells - z direction - must be a multiple of ZLEN       

# %%%%%%%%%%%%%%%%%% MPI TOPOLOGY %%%%%%%%%%%%%%%
XLEN = 2               # Number of subdomains in the X direction 
YLEN = 1               # Number of subdomains in the Y direction
ZLEN = 1               # Number of subdomains in the Z direction

# %%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%
#    0 = electrons
#    1 = protons
#    2,3,4,5,... = ions
# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

ns = 2                                 # Number of particles
rhoINIT         = 1.0  1.0 # Initial density (make sure you are neutral)
rhoINJECT       = 0.0  0.0 # Injection density (make sure you are neutral)
TrackParticleID = 0    0   # TrackParticleID[species] = 1=true, 0=false 

npcelx          = 100  100    # Particles per cell in X
npcely          = 1    1      # Particles per cell in Y
npcelz          = 1    1      # Particles per cell in Z
NpMaxNpRatio    = 3.0         # Maximum number of particles allocated

qom             = -64.0     1.0      # Charge/mass ratio
uth             =  0.1      0.01     # Thermal velocity in X
vth             =  0.0     0.0       # Thermal velocity in Y
wth             =  0.0    0.0        # Thermal velocity in Z
u0              =  0.0    0.0        # Drift velocity in X
v0              =  0.0        0.0    # Drift velocity in X
w0              =  0.0        0.0    # Drift velocity in X

# %%%%%%%%%%%%%% TEST PARTICLES %%%%%%%%%%%%%%%%%
#  They are saved every time step
#    TP_ns = number of species
#    0 = electrons
#    1 = protons
#    2,3,4,5,... = ions
#    if TP_ns = 0 all the values related with test particles (TP) are not needed
#
#
TP_ns = 0



# %%%%%%%%%%%% Periodicity in each direction %%%%%%%%%%%%%%%
PERIODICX       = 1                  # In direction X (1=true, 0=false)
PERIODICY       = 1                  # In direction Y (1=true, 0=false)
PERIODICZ       = 1                  # In direction Z (1=true, 0=false)


# %%%%%%%%%%%% Numerics options %%%%%%%%%%%%%%%
verbose                = 1        # Print to video results
Vinj                   = 0.0      # Velocity of the injection from the wall
CGtol                  = 1E-3     # CG solver stopping criterium tolerance
GMREStol               = 1E-6    # GMRES solver stopping criterium tolerance
NiterMover             = 3        # mover predictor corrector iteration
FieldOutputCycle       = 100      # Output for field
ParticlesOutputCycle   = 500  # Output for particles if 1 it doesnt save particles data
RestartOutputCycle     = 1000    # restart cycle
DiagnosticsOutputCycle = 10       # Diagnostics cycle
